rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // -------------------------------------------------------------------------
    // Helper Functions
    // -------------------------------------------------------------------------
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return isAuthenticated() && request.auth.token.role == 'admin';
    }
    
    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    // -------------------------------------------------------------------------
    // Executive Invoices & Receipts
    // -------------------------------------------------------------------------
    match /invoices/{invoiceFile} {
      // Readable by authenticated users or admins
      allow read: if isAuthenticated();
      // Writable by Cloud Functions admin / admin role
      allow write: if isAdmin();
    }

    // -------------------------------------------------------------------------
    // Avatars / Profile Pictures / Vehicles
    // -------------------------------------------------------------------------
    match /{allImages=**} {
      // Readable by signed-in users
      allow read: if isAuthenticated();
      
      // Writable only by admin
      allow write: if isAdmin();
    }
  }
}
